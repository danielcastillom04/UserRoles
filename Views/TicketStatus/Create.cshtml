@model UserRoles.Models.TicketStatus

@{
    ViewData["Title"] = "Crear Ticket Status";
}

<h1>Crear Ticket Status</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="TicketStatus" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
